{
  "$schema": "https://raw.githubusercontent.com/jamestryand/eventmodelschema/main/schema/eventmodeling.schema.json",
  "eventModelingSchemaVersion": "3.15.0",
  "id": "conditional-outcomes-example",
  "name": "Conditional Outcomes Example",
  "description": "Conditional outcomes (3.12.0): one command emits one set of events or another, and the model says when. Booking equipment for more than 14 days also flags the booking for review, by a declared rule. Requesting a refund also flags it when its amount, converted to the home currency, is over the threshold; converting is a calculation, so that condition is hand-written (`when: \"hand\"`).",
  "swimlanes": [
    { "id": "hire", "name": "Hire", "kind": "team" }
  ],
  "events": {
    "booking-made": {
      "name": "Booking Made",
      "swimlaneId": "hire",
      "aggregate": "booking",
      "fields": [
        { "name": "bookingId", "type": "string" },
        { "name": "days", "type": "decimal" }
      ]
    },
    "booking-flagged": {
      "name": "Booking Flagged",
      "swimlaneId": "hire",
      "aggregate": "booking",
      "fields": [
        { "name": "bookingId", "type": "string" },
        { "name": "reason", "type": "string" }
      ]
    },
    "refund-requested": {
      "name": "Refund Requested",
      "swimlaneId": "hire",
      "aggregate": "refund",
      "fields": [
        { "name": "refundId", "type": "string" },
        { "name": "amount", "type": "decimal" },
        { "name": "currency", "type": "string" }
      ]
    },
    "refund-flagged": {
      "name": "Refund Flagged",
      "swimlaneId": "hire",
      "aggregate": "refund",
      "fields": [
        { "name": "refundId", "type": "string" },
        { "name": "reason", "type": "string" }
      ]
    }
  },
  "commands": {
    "make-booking": {
      "name": "Make Booking",
      "aggregate": "booking",
      "fields": [{ "name": "days", "type": "decimal" }],
      "refuseWhen": [
        { "message": "days must be positive", "all": [{ "command": "days", "atMost": 0 }] }
      ]
    },
    "request-refund": {
      "name": "Request Refund",
      "aggregate": "refund",
      "fields": [
        { "name": "amount", "type": "decimal" },
        { "name": "currency", "type": "string" }
      ]
    }
  },
  "screens": {
    "bookings-screen": { "name": "Bookings" },
    "refunds-screen": { "name": "Refunds" }
  },
  "slices": [
    {
      "id": "make-booking-slice",
      "name": "Make Booking",
      "pattern": "stateChange",
      "swimlaneId": "hire",
      "status": "created",
      "screenId": "bookings-screen",
      "commandId": "make-booking",
      "eventIds": ["booking-made", "booking-flagged"],
      "outcomes": [
        {
          "eventIds": ["booking-made", "booking-flagged"],
          "description": "A long hire is booked and flagged for review, in the same commit.",
          "when": [{ "all": [{ "command": "days", "greaterThan": 14 }] }],
          "set": { "booking-flagged": { "reason": "long-hire" } }
        },
        { "eventIds": ["booking-made"] }
      ],
      "scenarios": [
        {
          "id": "make-a-booking", "name": "An ordinary hire is booked", "kind": "stateChange",
          "given": [], "when": { "commandId": "make-booking", "data": { "days": 7 } },
          "then": { "events": [{ "eventId": "booking-made", "data": { "days": 7 } }] }
        },
        {
          "id": "long-hire-is-flagged", "name": "More than 14 days is booked and flagged", "kind": "stateChange",
          "given": [], "when": { "commandId": "make-booking", "data": { "days": 15 } },
          "then": {
            "events": [
              { "eventId": "booking-made", "data": { "days": 15 } },
              { "eventId": "booking-flagged", "data": { "reason": "long-hire" } }
            ]
          }
        },
        {
          "id": "refused-before-outcomes", "name": "Refusals come before outcomes", "kind": "error",
          "given": [], "when": { "commandId": "make-booking", "data": { "days": -1 } },
          "then": { "error": { "message": "days must be positive" } }
        }
      ]
    },
    {
      "id": "request-refund-slice",
      "name": "Request Refund",
      "pattern": "stateChange",
      "swimlaneId": "hire",
      "status": "created",
      "screenId": "refunds-screen",
      "commandId": "request-refund",
      "eventIds": ["refund-requested", "refund-flagged"],
      "outcomes": [
        {
          "eventIds": ["refund-requested", "refund-flagged"],
          "description": "Over the threshold once converted to the home currency: a calculation, so the condition is hand-written.",
          "when": "hand",
          "set": { "refund-flagged": { "reason": "over-threshold" } }
        },
        { "eventIds": ["refund-requested"] }
      ],
      "scenarios": [
        {
          "id": "refund-over-threshold", "name": "A refund over the threshold is requested and flagged", "kind": "stateChange",
          "given": [], "when": { "commandId": "request-refund", "data": { "amount": 900, "currency": "USD" } },
          "then": {
            "events": [
              { "eventId": "refund-requested", "data": { "amount": 900 } },
              { "eventId": "refund-flagged", "data": { "reason": "over-threshold" } }
            ]
          }
        }
      ]
    }
  ]
}
