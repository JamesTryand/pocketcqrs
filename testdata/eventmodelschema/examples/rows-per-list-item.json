{
  "$schema": "https://raw.githubusercontent.com/jamestryand/eventmodelschema/main/schema/eventmodeling.schema.json",
  "eventModelingSchemaVersion": "3.16.0",
  "id": "rows-per-list-item-example",
  "name": "Rows Per List Item Example",
  "description": "Rows per list item (3.16.0): a delivery run's parcels, each carrying the depot it goes through, are shown to each depot's supervisor as that depot's load on the run: one row per delivery and depot, holding the depot's parcels, their total weight and the delivery's status and run number. The rows are built from the delivery's own events (rowsPerListItem); the total weight is the sum of a subfield over the row's parcels, given only once every parcel carries it (sumOfItems); the status is a literal per event (byEvent). An item with no depot, such as the van's roll cages, is in no row.",
  "swimlanes": [
    {
      "id": "dispatch",
      "name": "Dispatch",
      "kind": "team"
    }
  ],
  "events": {
    "delivery-planned": {
      "name": "Delivery Planned",
      "swimlaneId": "dispatch",
      "aggregate": "delivery",
      "fields": [
        {
          "name": "deliveryId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "customerId",
          "type": "string"
        },
        {
          "name": "parcels",
          "type": "custom",
          "cardinality": "list",
          "description": "Each parcel with its declared weight, before weighing: no weighedWeightKg yet.",
          "subfields": [
            {
              "name": "parcelId",
              "type": "string"
            },
            {
              "name": "depotId",
              "type": "string",
              "optional": true
            },
            {
              "name": "declaredWeightKg",
              "type": "decimal",
              "optional": true
            },
            {
              "name": "weighedWeightKg",
              "type": "decimal",
              "optional": true
            },
            {
              "name": "description",
              "type": "string",
              "optional": true
            }
          ]
        }
      ]
    },
    "delivery-dispatched": {
      "name": "Delivery Dispatched",
      "swimlaneId": "dispatch",
      "aggregate": "delivery",
      "fields": [
        {
          "name": "deliveryId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "runNumber",
          "type": "string"
        },
        {
          "name": "vehicleId",
          "type": "string"
        },
        {
          "name": "parcels",
          "type": "custom",
          "cardinality": "list",
          "description": "Each parcel weighed at loading; the van's roll cages are an item with no depot.",
          "subfields": [
            {
              "name": "parcelId",
              "type": "string"
            },
            {
              "name": "depotId",
              "type": "string",
              "optional": true
            },
            {
              "name": "declaredWeightKg",
              "type": "decimal",
              "optional": true
            },
            {
              "name": "weighedWeightKg",
              "type": "decimal",
              "optional": true
            },
            {
              "name": "description",
              "type": "string",
              "optional": true
            }
          ]
        }
      ]
    },
    "delivery-cancelled": {
      "name": "Delivery Cancelled",
      "swimlaneId": "dispatch",
      "aggregate": "delivery",
      "fields": [
        {
          "name": "deliveryId",
          "type": "string",
          "idAttribute": true
        }
      ]
    }
  },
  "commands": {
    "plan-delivery": {
      "name": "Plan Delivery",
      "aggregate": "delivery",
      "fields": [
        {
          "name": "customerId",
          "type": "string"
        }
      ]
    },
    "dispatch-delivery": {
      "name": "Dispatch Delivery",
      "aggregate": "delivery",
      "fields": [
        {
          "name": "vehicleId",
          "type": "string"
        }
      ]
    },
    "cancel-delivery": {
      "name": "Cancel Delivery",
      "aggregate": "delivery",
      "fields": []
    }
  },
  "readModels": {
    "depot-loads": {
      "name": "Depot Loads",
      "question": "What is each depot's load on each delivery: its parcels, their total weight, and the delivery's status and run number?",
      "builtFromEventIds": [
        "delivery-planned",
        "delivery-dispatched",
        "delivery-cancelled"
      ],
      "removedByEventIds": [
        "delivery-cancelled"
      ],
      "rowsPerListItem": {
        "listField": "parcels",
        "groupBy": "depotId"
      },
      "fields": [
        {
          "name": "loadId",
          "type": "string",
          "idAttribute": true,
          "description": "<delivery stream>|<depotId>"
        },
        {
          "name": "deliveryId",
          "type": "string"
        },
        {
          "name": "depotId",
          "type": "string"
        },
        {
          "name": "customerId",
          "type": "string"
        },
        {
          "name": "runNumber",
          "type": "string"
        },
        {
          "name": "vehicleId",
          "type": "string"
        },
        {
          "name": "status",
          "type": "string",
          "derivation": {
            "kind": "byEvent",
            "values": {
              "delivery-planned": "planned",
              "delivery-dispatched": "dispatched"
            }
          }
        },
        {
          "name": "parcels",
          "type": "custom",
          "cardinality": "list",
          "description": "The depot's own parcels.",
          "subfields": [
            {
              "name": "parcelId",
              "type": "string"
            },
            {
              "name": "depotId",
              "type": "string",
              "optional": true
            },
            {
              "name": "declaredWeightKg",
              "type": "decimal",
              "optional": true
            },
            {
              "name": "weighedWeightKg",
              "type": "decimal",
              "optional": true
            },
            {
              "name": "description",
              "type": "string",
              "optional": true
            }
          ]
        },
        {
          "name": "totalWeightKg",
          "type": "decimal",
          "derivation": {
            "kind": "sumOfItems",
            "subfield": "weighedWeightKg"
          },
          "description": "The depot's parcels by weighed weight, once every one of them is weighed."
        }
      ]
    }
  },
  "screens": {
    "dispatch-screen": {
      "name": "Dispatch"
    }
  },
  "slices": [
    {
      "id": "plan-delivery-slice",
      "name": "Plan Delivery",
      "pattern": "stateChange",
      "swimlaneId": "dispatch",
      "status": "created",
      "screenId": "dispatch-screen",
      "commandId": "plan-delivery",
      "eventIds": [
        "delivery-planned"
      ],
      "scenarios": []
    },
    {
      "id": "dispatch-delivery-slice",
      "name": "Dispatch Delivery",
      "pattern": "stateChange",
      "swimlaneId": "dispatch",
      "status": "created",
      "screenId": "dispatch-screen",
      "commandId": "dispatch-delivery",
      "eventIds": [
        "delivery-dispatched"
      ],
      "scenarios": []
    },
    {
      "id": "cancel-delivery-slice",
      "name": "Cancel Delivery",
      "pattern": "stateChange",
      "swimlaneId": "dispatch",
      "status": "created",
      "screenId": "dispatch-screen",
      "commandId": "cancel-delivery",
      "eventIds": [
        "delivery-cancelled"
      ],
      "scenarios": []
    },
    {
      "id": "view-depot-loads-slice",
      "name": "View Depot Loads",
      "pattern": "stateView",
      "swimlaneId": "dispatch",
      "status": "created",
      "screenId": "dispatch-screen",
      "readModelId": "depot-loads",
      "scenarios": [
        {
          "id": "dispatched-delivery-has-a-load-per-depot",
          "kind": "stateView",
          "name": "A dispatched delivery has a load per depot: d1's two parcels of 13.00 kg are 26.00 kg, d2's one is 6.00 kg; the roll cages of 40.50 kg have no depot and are in neither",
          "given": [
            {
              "eventId": "delivery-planned",
              "data": {
                "deliveryId": "del-1",
                "customerId": "c1",
                "parcels": [
                  {
                    "parcelId": "pc1",
                    "depotId": "d1",
                    "declaredWeightKg": 12
                  },
                  {
                    "parcelId": "pc2",
                    "depotId": "d1",
                    "declaredWeightKg": 12
                  },
                  {
                    "parcelId": "pc3",
                    "depotId": "d2",
                    "declaredWeightKg": 5
                  }
                ]
              }
            },
            {
              "eventId": "delivery-dispatched",
              "data": {
                "deliveryId": "del-1",
                "runNumber": "RUN-7",
                "vehicleId": "van-3",
                "parcels": [
                  {
                    "parcelId": "pc1",
                    "depotId": "d1",
                    "declaredWeightKg": 12,
                    "weighedWeightKg": 13
                  },
                  {
                    "parcelId": "pc2",
                    "depotId": "d1",
                    "declaredWeightKg": 12,
                    "weighedWeightKg": 13
                  },
                  {
                    "parcelId": "pc3",
                    "depotId": "d2",
                    "declaredWeightKg": 5,
                    "weighedWeightKg": 6
                  },
                  {
                    "parcelId": "roll-cages",
                    "weighedWeightKg": 40.5,
                    "description": "Roll cages"
                  }
                ]
              }
            }
          ],
          "when": {
            "readModelId": "depot-loads"
          },
          "then": {
            "result": {
              "entries": [
                {
                  "deliveryId": "del-1",
                  "depotId": "d1",
                  "customerId": "c1",
                  "runNumber": "RUN-7",
                  "status": "dispatched",
                  "totalWeightKg": 26
                },
                {
                  "deliveryId": "del-1",
                  "depotId": "d2",
                  "customerId": "c1",
                  "runNumber": "RUN-7",
                  "status": "dispatched",
                  "totalWeightKg": 6
                }
              ]
            }
          }
        },
        {
          "id": "a-planned-deliverys-loads-have-no-total-weight",
          "kind": "stateView",
          "name": "A planned delivery's loads have their parcels but no total weight: the parcels carry only declared weights, not yet weighed",
          "given": [
            {
              "eventId": "delivery-planned",
              "data": {
                "deliveryId": "del-1",
                "customerId": "c1",
                "parcels": [
                  {
                    "parcelId": "pc1",
                    "depotId": "d1",
                    "declaredWeightKg": 12
                  },
                  {
                    "parcelId": "pc2",
                    "depotId": "d1",
                    "declaredWeightKg": 12
                  },
                  {
                    "parcelId": "pc3",
                    "depotId": "d2",
                    "declaredWeightKg": 5
                  }
                ]
              }
            }
          ],
          "when": {
            "readModelId": "depot-loads"
          },
          "then": {
            "result": {
              "entries": [
                {
                  "deliveryId": "del-1",
                  "depotId": "d1",
                  "status": "planned",
                  "totalWeightKg": null
                },
                {
                  "deliveryId": "del-1",
                  "depotId": "d2",
                  "status": "planned",
                  "totalWeightKg": null
                }
              ]
            }
          }
        },
        {
          "id": "a-cancelled-deliverys-loads-leave",
          "kind": "stateView",
          "name": "A cancelled delivery's loads leave",
          "given": [
            {
              "eventId": "delivery-planned",
              "data": {
                "deliveryId": "del-1",
                "customerId": "c1",
                "parcels": [
                  {
                    "parcelId": "pc1",
                    "depotId": "d1",
                    "declaredWeightKg": 12
                  },
                  {
                    "parcelId": "pc2",
                    "depotId": "d1",
                    "declaredWeightKg": 12
                  },
                  {
                    "parcelId": "pc3",
                    "depotId": "d2",
                    "declaredWeightKg": 5
                  }
                ]
              }
            },
            {
              "eventId": "delivery-cancelled",
              "data": {
                "deliveryId": "del-1"
              }
            }
          ],
          "when": {
            "readModelId": "depot-loads"
          },
          "then": {
            "result": {
              "entries": []
            }
          }
        }
      ]
    }
  ]
}
