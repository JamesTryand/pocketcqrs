{
  "id": "notify-shipping-partner-slice",
  "name": "Notify Shipping Partner",
  "pattern": "automation",
  "swimlaneId": "shipping-partner",
  "chapterId": "order-lifecycle",
  "businessCapability": "Keep the external shipping partner informed of shipments",
  "status": "planned",
  "automationId": "notify-shipping-partner-automation",
  "triggerEventIds": [
    "order-shipped"
  ],
  "effect": {
    "swimlaneId": "shipping-partner",
    "description": "POST the shipment to the partner's API.",
    "gaveUp": {
      "commandId": "record-partner-notification-abandoned",
      "resultEventIds": [
        "partner-notification-abandoned"
      ]
    }
  },
  "commandId": "record-partner-notified",
  "resultEventIds": [
    "shipment-notified"
  ],
  "scenarios": [
    {
      "id": "notify-partner-on-shipment",
      "name": "A warehouse shipment automatically notifies the shipping partner",
      "kind": "stateChange",
      "given": [
        {
          "eventId": "order-shipped",
          "data": {
            "orderId": "order-1"
          }
        }
      ],
      "when": {
        "commandId": "record-partner-notified",
        "data": {
          "orderId": "order-1"
        }
      },
      "then": {
        "events": [
          {
            "eventId": "shipment-notified",
            "data": {
              "orderId": "order-1"
            }
          }
        ]
      }
    },
    {
      "id": "partner-unreachable",
      "name": "When the partner can't be reached, the runtime gives up and says so",
      "kind": "stateChange",
      "given": [
        {
          "eventId": "order-shipped",
          "data": {
            "orderId": "order-1"
          }
        }
      ],
      "when": {
        "commandId": "record-partner-notification-abandoned",
        "data": {
          "orderId": "order-1",
          "reason": "timed out after 5 attempts"
        }
      },
      "then": {
        "events": [
          {
            "eventId": "partner-notification-abandoned",
            "data": {
              "orderId": "order-1"
            }
          }
        ]
      }
    }
  ]
}
