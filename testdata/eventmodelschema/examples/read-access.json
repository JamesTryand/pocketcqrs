{
  "$schema": "https://raw.githubusercontent.com/jamestryand/eventmodelschema/main/schema/eventmodeling.schema.json",
  "eventModelingSchemaVersion": "3.15.0",
  "id": "read-access-example",
  "name": "Read Access Example",
  "description": "Who may read which rows of a read model (3.8.0). A supervisor holds requiredRole and sees every ticket. Anyone else sees the tickets they own (selfAccess) and the tickets of teams they lead (a scope with grantsAccess), and nothing else. The selfAccess param lets a supervisor ask for only their own tickets too. Each stateView scenario names its caller.",
  "swimlanes": [
    { "id": "desk", "name": "Support Desk", "kind": "team" }
  ],
  "events": {
    "team-lead-assigned": {
      "name": "Team Lead Assigned",
      "swimlaneId": "desk",
      "aggregate": "team",
      "fields": [
        { "name": "assignmentId", "type": "string", "idAttribute": true },
        { "name": "teamId", "type": "string" },
        { "name": "agentId", "type": "string" }
      ]
    },
    "team-lead-unassigned": {
      "name": "Team Lead Unassigned",
      "swimlaneId": "desk",
      "aggregate": "team",
      "fields": [
        { "name": "assignmentId", "type": "string", "idAttribute": true },
        { "name": "teamId", "type": "string" },
        { "name": "agentId", "type": "string" }
      ]
    },
    "ticket-opened": {
      "name": "Ticket Opened",
      "swimlaneId": "desk",
      "aggregate": "ticket",
      "fields": [
        { "name": "ticketId", "type": "string", "idAttribute": true },
        { "name": "teamId", "type": "string" },
        { "name": "agentId", "type": "string" },
        { "name": "estimatedEffort", "type": "decimal" }
      ]
    }
  },
  "commands": {
    "open-ticket": { "name": "Open Ticket", "aggregate": "ticket" },
    "assign-team-lead": { "name": "Assign Team Lead", "aggregate": "team" },
    "unassign-team-lead": { "name": "Unassign Team Lead", "aggregate": "team" }
  },
  "readModels": {
    "team-leads": {
      "name": "Team Leads",
      "question": "Who leads which team?",
      "builtFromEventIds": ["team-lead-assigned", "team-lead-unassigned"],
      "removedByEventIds": ["team-lead-unassigned"],
      "fields": [
        { "name": "assignmentId", "type": "string", "idAttribute": true },
        { "name": "teamId", "type": "string" },
        { "name": "agentId", "type": "string" }
      ],
      "requiredRole": "supervisor"
    },
    "tickets": {
      "name": "Tickets",
      "question": "Which tickets have been opened, owned by whom, in which team?",
      "builtFromEventIds": ["ticket-opened"],
      "fields": [
        { "name": "ticketId", "type": "string", "idAttribute": true },
        { "name": "teamId", "type": "string" },
        { "name": "agentId", "type": "string" },
        { "name": "estimatedEffort", "type": "decimal" }
      ],
      "requiredRole": "supervisor",
      "selfAccess": { "subjectField": "agentId", "param": "mine" },
      "scopes": [
        {
          "param": "ledBy",
          "via": {
            "readModelId": "team-leads",
            "matchParamTo": "agentId",
            "selectField": "teamId",
            "filterLocalField": "teamId"
          },
          "grantsAccess": true
        }
      ]
    }
  },
  "screens": {
    "open-ticket-screen": { "name": "Open Ticket" },
    "teams-screen": { "name": "Teams" },
    "my-tickets-screen": { "name": "My Tickets" }
  },
  "slices": [
    {
      "id": "assign-team-lead-slice",
      "name": "Assign Team Lead",
      "pattern": "stateChange",
      "swimlaneId": "desk",
      "status": "created",
      "screenId": "teams-screen",
      "commandId": "assign-team-lead",
      "eventIds": ["team-lead-assigned"],
      "scenarios": []
    },
    {
      "id": "unassign-team-lead-slice",
      "name": "Unassign Team Lead",
      "pattern": "stateChange",
      "swimlaneId": "desk",
      "status": "created",
      "screenId": "teams-screen",
      "commandId": "unassign-team-lead",
      "eventIds": ["team-lead-unassigned"],
      "scenarios": []
    },
    {
      "id": "open-ticket-slice",
      "name": "Open Ticket",
      "pattern": "stateChange",
      "swimlaneId": "desk",
      "status": "created",
      "screenId": "open-ticket-screen",
      "commandId": "open-ticket",
      "eventIds": ["ticket-opened"],
      "scenarios": []
    },
    {
      "id": "view-tickets-slice",
      "name": "View Tickets",
      "pattern": "stateView",
      "swimlaneId": "desk",
      "status": "created",
      "screenId": "my-tickets-screen",
      "readModelId": "tickets",
      "scenarios": [
        {
          "id": "supervisor-sees-every-ticket",
          "name": "A supervisor holds requiredRole, so sees every ticket",
          "kind": "stateView",
          "given": [
            { "eventId": "ticket-opened", "data": { "ticketId": "t1", "teamId": "g1", "agentId": "a1", "estimatedEffort": 2 } },
            { "eventId": "ticket-opened", "data": { "ticketId": "t2", "teamId": "g2", "agentId": "a2", "estimatedEffort": 3 } }
          ],
          "when": { "readModelId": "tickets", "caller": { "subjectId": "sup1", "role": "supervisor" } },
          "then": {
            "result": {
              "tickets": [
                { "ticketId": "t1", "agentId": "a1" },
                { "ticketId": "t2", "agentId": "a2" }
              ]
            }
          }
        },
        {
          "id": "agent-sees-only-own-tickets",
          "name": "Anyone else sees only the tickets they own, without asking for them",
          "kind": "stateView",
          "given": [
            { "eventId": "ticket-opened", "data": { "ticketId": "t1", "teamId": "g1", "agentId": "a1", "estimatedEffort": 2 } },
            { "eventId": "ticket-opened", "data": { "ticketId": "t2", "teamId": "g2", "agentId": "a2", "estimatedEffort": 3 } }
          ],
          "when": { "readModelId": "tickets", "caller": { "subjectId": "a1", "role": "agent" } },
          "then": { "result": { "tickets": [ { "ticketId": "t1", "agentId": "a1" } ] } }
        },
        {
          "id": "team-lead-also-sees-led-teams",
          "name": "A granting scope adds the tickets of teams the caller leads",
          "kind": "stateView",
          "given": [
            { "eventId": "team-lead-assigned", "data": { "assignmentId": "g2:a1", "teamId": "g2", "agentId": "a1" } },
            { "eventId": "ticket-opened", "data": { "ticketId": "t1", "teamId": "g1", "agentId": "a1", "estimatedEffort": 2 } },
            { "eventId": "ticket-opened", "data": { "ticketId": "t2", "teamId": "g2", "agentId": "a2", "estimatedEffort": 3 } },
            { "eventId": "ticket-opened", "data": { "ticketId": "t3", "teamId": "g3", "agentId": "a3", "estimatedEffort": 1 } }
          ],
          "when": { "readModelId": "tickets", "caller": { "subjectId": "a1", "role": "agent" } },
          "then": {
            "result": {
              "tickets": [
                { "ticketId": "t1", "agentId": "a1" },
                { "ticketId": "t2", "agentId": "a2" }
              ]
            }
          }
        },
        {
          "id": "an-unassigned-team-lead-loses-the-grant",
          "name": "Unassigning removes the team-leads row, and with it the access it granted",
          "kind": "stateView",
          "given": [
            { "eventId": "team-lead-assigned", "data": { "assignmentId": "g2:a1", "teamId": "g2", "agentId": "a1" } },
            { "eventId": "team-lead-unassigned", "data": { "assignmentId": "g2:a1", "teamId": "g2", "agentId": "a1" } },
            { "eventId": "ticket-opened", "data": { "ticketId": "t2", "teamId": "g2", "agentId": "a2", "estimatedEffort": 3 } }
          ],
          "when": { "readModelId": "tickets", "caller": { "subjectId": "a1", "role": "agent" } },
          "then": { "result": { "tickets": [] } }
        },
        {
          "id": "a-param-cannot-widen-access",
          "name": "A scope param names the caller, whatever value is sent",
          "kind": "stateView",
          "given": [
            { "eventId": "team-lead-assigned", "data": { "assignmentId": "g2:a2", "teamId": "g2", "agentId": "a2" } },
            { "eventId": "ticket-opened", "data": { "ticketId": "t2", "teamId": "g2", "agentId": "a2", "estimatedEffort": 3 } }
          ],
          "when": {
            "readModelId": "tickets",
            "queryParams": { "ledBy": "a2" },
            "caller": { "subjectId": "a1", "role": "agent" }
          },
          "then": { "result": { "tickets": [] } }
        },
        {
          "id": "supervisor-asks-for-own-tickets",
          "name": "The selfAccess param narrows even a role holder to the tickets they own",
          "kind": "stateView",
          "given": [
            { "eventId": "ticket-opened", "data": { "ticketId": "t1", "teamId": "g1", "agentId": "sup1", "estimatedEffort": 2 } },
            { "eventId": "ticket-opened", "data": { "ticketId": "t2", "teamId": "g2", "agentId": "a2", "estimatedEffort": 3 } }
          ],
          "when": {
            "readModelId": "tickets",
            "queryParams": { "mine": "true" },
            "caller": { "subjectId": "sup1", "role": "supervisor" }
          },
          "then": { "result": { "tickets": [ { "ticketId": "t1", "agentId": "sup1" } ] } }
        }
      ]
    }
  ]
}
