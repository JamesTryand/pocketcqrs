{
  "$schema": "https://raw.githubusercontent.com/jamestryand/eventmodelschema/main/schema/eventmodeling.schema.json",
  "eventModelingSchemaVersion": "3.15.0",
  "id": "refusals-example",
  "name": "Refusals Example",
  "description": "Declared refusals (3.10.0; numeric comparisons, 3.11.0): a room booking is held by one event plan at a time, and cannot be changed while it is held. Each rule reads the booking's own state (folded from its own events) and the command, never a read model.",
  "swimlanes": [
    { "id": "bookings", "name": "Bookings", "kind": "team" }
  ],
  "events": {
    "booking-made": {
      "name": "Booking Made",
      "swimlaneId": "bookings",
      "aggregate": "booking",
      "fields": [
        { "name": "bookingId", "type": "string" },
        { "name": "duration", "type": "decimal" }
      ]
    },
    "booking-held-for-event-plan": {
      "name": "Booking Held For Event Plan",
      "swimlaneId": "bookings",
      "aggregate": "booking",
      "fields": [
        { "name": "bookingId", "type": "string" },
        { "name": "heldForPlanId", "type": "string" }
      ]
    },
    "booking-changed": {
      "name": "Booking Changed",
      "swimlaneId": "bookings",
      "aggregate": "booking",
      "fields": [
        { "name": "bookingId", "type": "string" },
        { "name": "duration", "type": "decimal" }
      ]
    }
  },
  "commands": {
    "make-booking": {
      "name": "Make Booking",
      "aggregate": "booking",
      "fields": [{ "name": "duration", "type": "decimal" }]
    },
    "hold-booking-for-event-plan": {
      "name": "Hold Booking For Event Plan",
      "aggregate": "booking",
      "fields": [{ "name": "heldForPlanId", "type": "string" }],
      "refuseWhen": [
        {
          "message": "booking is held by another event plan",
          "all": [
            { "state": "heldForPlanId", "is": "set" },
            { "state": "heldForPlanId", "notEquals": { "command": "heldForPlanId" } }
          ]
        }
      ]
    },
    "change-booking": {
      "name": "Change Booking",
      "aggregate": "booking",
      "fields": [{ "name": "duration", "type": "decimal" }],
      "refuseWhen": [
        { "message": "booking is held by an event plan", "all": [{ "state": "heldForPlanId", "is": "set" }] },
        { "message": "duration must be positive", "all": [{ "command": "duration", "atMost": 0 }] },
        { "message": "a booking lasts at most one day", "all": [{ "command": "duration", "greaterThan": 24 }] }
      ]
    }
  },
  "screens": {
    "bookings-screen": { "name": "Bookings" },
    "event-planning-screen": { "name": "Event Planning" }
  },
  "slices": [
    {
      "id": "make-booking-slice",
      "name": "Make Booking",
      "pattern": "stateChange",
      "swimlaneId": "bookings",
      "status": "created",
      "screenId": "bookings-screen",
      "commandId": "make-booking",
      "eventIds": ["booking-made"],
      "scenarios": [
        {
          "id": "make-a-booking", "name": "Make a booking", "kind": "stateChange",
          "given": [], "when": { "commandId": "make-booking", "data": { "duration": 6 } },
          "then": { "events": [{ "eventId": "booking-made" }] }
        }
      ]
    },
    {
      "id": "hold-booking-slice",
      "name": "Hold Booking For Event Plan",
      "pattern": "stateChange",
      "swimlaneId": "bookings",
      "status": "created",
      "screenId": "event-planning-screen",
      "commandId": "hold-booking-for-event-plan",
      "eventIds": ["booking-held-for-event-plan"],
      "scenarios": [
        {
          "id": "hold-a-booking", "name": "A booking nobody holds is held", "kind": "stateChange",
          "given": [{ "eventId": "booking-made", "data": { "bookingId": "b1", "duration": 6 } }],
          "when": { "commandId": "hold-booking-for-event-plan", "data": { "heldForPlanId": "plan-1" } },
          "then": { "events": [{ "eventId": "booking-held-for-event-plan" }] }
        },
        {
          "id": "held-by-another-plan", "name": "A booking held by one event plan cannot be held by another", "kind": "error",
          "given": [
            { "eventId": "booking-made", "data": { "bookingId": "b1", "duration": 6 } },
            { "eventId": "booking-held-for-event-plan", "data": { "bookingId": "b1", "heldForPlanId": "plan-1" } }
          ],
          "when": { "commandId": "hold-booking-for-event-plan", "data": { "heldForPlanId": "plan-2" } },
          "then": { "error": { "message": "booking is held by another event plan" } }
        }
      ]
    },
    {
      "id": "change-booking-slice",
      "name": "Change Booking",
      "pattern": "stateChange",
      "swimlaneId": "bookings",
      "status": "created",
      "screenId": "bookings-screen",
      "commandId": "change-booking",
      "eventIds": ["booking-changed"],
      "scenarios": [
        {
          "id": "change-a-booking", "name": "A booking nobody holds can be changed", "kind": "stateChange",
          "given": [{ "eventId": "booking-made", "data": { "bookingId": "b1", "duration": 6 } }],
          "when": { "commandId": "change-booking", "data": { "duration": 8 } },
          "then": { "events": [{ "eventId": "booking-changed" }] }
        },
        {
          "id": "held-booking-cannot-change", "name": "A held booking cannot be changed", "kind": "error",
          "given": [
            { "eventId": "booking-made", "data": { "bookingId": "b1", "duration": 6 } },
            { "eventId": "booking-held-for-event-plan", "data": { "bookingId": "b1", "heldForPlanId": "plan-1" } }
          ],
          "when": { "commandId": "change-booking", "data": { "duration": 8 } },
          "then": { "error": { "message": "booking is held by an event plan" } }
        },
        {
          "id": "duration-must-be-positive", "name": "A negative duration is refused (3.11.0: atMost)", "kind": "error",
          "given": [{ "eventId": "booking-made", "data": { "bookingId": "b1", "duration": 6 } }],
          "when": { "commandId": "change-booking", "data": { "duration": -2 } },
          "then": { "error": { "message": "duration must be positive" } }
        },
        {
          "id": "at-most-one-day", "name": "A duration over 24 is refused (3.11.0: greaterThan)", "kind": "error",
          "given": [{ "eventId": "booking-made", "data": { "bookingId": "b1", "duration": 6 } }],
          "when": { "commandId": "change-booking", "data": { "duration": 25 } },
          "then": { "error": { "message": "a booking lasts at most one day" } }
        }
      ]
    }
  ]
}
