{
  "$schema": "https://raw.githubusercontent.com/jamestryand/eventmodelschema/main/schema/eventmodeling.schema.json",
  "eventModelingSchemaVersion": "3.15.0",
  "id": "repeated-outcomes-example",
  "name": "Repeated Outcomes Example",
  "description": "Repeated events in an outcome (3.13.0): closing a grant round records the closing and one award per recipient, in one decision. Each award is its own event, so each recipient's award is encrypted under their own key. How many awards, and how much each, is worked out by hand from the round's own state. Each award is a row of its own in the awards read model, keyed by the award's id rather than the grant round's stream (3.14.0 rowKeyField).",
  "swimlanes": [
    {
      "id": "grants",
      "name": "Grants",
      "kind": "team"
    }
  ],
  "events": {
    "application-approved": {
      "name": "Application Approved",
      "swimlaneId": "grants",
      "aggregate": "grant_round",
      "fields": [
        {
          "name": "grantRoundId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "recipientId",
          "type": "string"
        },
        {
          "name": "amount",
          "type": "decimal",
          "pii": true,
          "piiSubject": "recipientId"
        }
      ]
    },
    "grant-round-closed": {
      "name": "Grant Round Closed",
      "swimlaneId": "grants",
      "aggregate": "grant_round",
      "fields": [
        {
          "name": "grantRoundId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "closingDate",
          "type": "date"
        }
      ]
    },
    "grant-awarded": {
      "name": "Grant Awarded",
      "swimlaneId": "grants",
      "aggregate": "grant_round",
      "fields": [
        {
          "name": "grantRoundId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "recipientId",
          "type": "string"
        },
        {
          "name": "awardId",
          "type": "string"
        },
        {
          "name": "closingDate",
          "type": "date"
        },
        {
          "name": "amount",
          "type": "decimal",
          "pii": true,
          "piiSubject": "recipientId"
        }
      ]
    }
  },
  "commands": {
    "close-grant-round": {
      "name": "Close Grant Round",
      "aggregate": "grant_round",
      "fields": [
        {
          "name": "closingDate",
          "type": "date"
        }
      ]
    }
  },
  "readModels": {
    "awards": {
      "name": "Awards",
      "question": "What has each recipient been awarded, round by round?",
      "builtFromEventIds": [
        "grant-awarded"
      ],
      "rowKeyField": "awardId",
      "fields": [
        {
          "name": "awardId",
          "type": "string",
          "idAttribute": true
        },
        {
          "name": "grantRoundId",
          "type": "string"
        },
        {
          "name": "recipientId",
          "type": "string"
        },
        {
          "name": "closingDate",
          "type": "date"
        },
        {
          "name": "amount",
          "type": "decimal",
          "pii": true,
          "piiSubject": "recipientId"
        }
      ]
    }
  },
  "screens": {
    "grants-screen": {
      "name": "Grants"
    }
  },
  "slices": [
    {
      "id": "close-grant-round-slice",
      "name": "Close Grant Round",
      "pattern": "stateChange",
      "swimlaneId": "grants",
      "status": "created",
      "screenId": "grants-screen",
      "commandId": "close-grant-round",
      "eventIds": [
        "grant-round-closed",
        "grant-awarded"
      ],
      "outcomes": [
        {
          "eventIds": [
            "grant-round-closed",
            "grant-awarded"
          ],
          "repeated": [
            "grant-awarded"
          ],
          "description": "The closing, then one award per recipient with an approved application."
        }
      ],
      "scenarios": [
        {
          "id": "two-recipients-awarded",
          "name": "Two recipients with approved applications each receive an award",
          "kind": "stateChange",
          "given": [
            {
              "eventId": "application-approved",
              "data": {
                "grantRoundId": "g1",
                "recipientId": "r1",
                "amount": 1200
              }
            },
            {
              "eventId": "application-approved",
              "data": {
                "grantRoundId": "g1",
                "recipientId": "r2",
                "amount": 800
              }
            }
          ],
          "when": {
            "commandId": "close-grant-round",
            "data": {
              "closingDate": "2026-09-30"
            }
          },
          "then": {
            "events": [
              {
                "eventId": "grant-round-closed",
                "data": {
                  "closingDate": "2026-09-30"
                }
              },
              {
                "eventId": "grant-awarded",
                "data": {
                  "recipientId": "r1",
                  "amount": 1200,
                  "awardId": "g1:r1"
                }
              },
              {
                "eventId": "grant-awarded",
                "data": {
                  "recipientId": "r2",
                  "amount": 800,
                  "awardId": "g1:r2"
                }
              }
            ]
          }
        },
        {
          "id": "no-applications-approved",
          "name": "With no applications approved, the closing awards nothing",
          "kind": "stateChange",
          "given": [],
          "when": {
            "commandId": "close-grant-round",
            "data": {
              "closingDate": "2026-09-30"
            }
          },
          "then": {
            "events": [
              {
                "eventId": "grant-round-closed",
                "data": {
                  "closingDate": "2026-09-30"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "view-awards-slice",
      "name": "View Awards",
      "pattern": "stateView",
      "swimlaneId": "grants",
      "status": "created",
      "screenId": "grants-screen",
      "readModelId": "awards",
      "scenarios": [
        {
          "id": "one-row-per-award",
          "name": "Two awards in one grant round are two rows",
          "kind": "stateView",
          "given": [
            {
              "eventId": "grant-awarded",
              "data": {
                "grantRoundId": "g1",
                "recipientId": "r1",
                "awardId": "g1:r1",
                "closingDate": "2026-09-30",
                "amount": 1200
              }
            },
            {
              "eventId": "grant-awarded",
              "data": {
                "grantRoundId": "g1",
                "recipientId": "r2",
                "awardId": "g1:r2",
                "closingDate": "2026-09-30",
                "amount": 800
              }
            }
          ],
          "when": {
            "readModelId": "awards"
          },
          "then": {
            "result": {
              "entries": [
                {
                  "awardId": "g1:r1",
                  "recipientId": "r1",
                  "amount": 1200
                },
                {
                  "awardId": "g1:r2",
                  "recipientId": "r2",
                  "amount": 800
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
