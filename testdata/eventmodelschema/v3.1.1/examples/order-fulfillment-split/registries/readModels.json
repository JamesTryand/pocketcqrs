{
  "order-summary": {
    "name": "Order Summary",
    "description": "Current status of a single order.",
    "question": "What's the current status of my order?",
    "builtFromEventIds": [
      "order-placed",
      "order-shipped"
    ],
    "fields": [
      {
        "name": "orderId",
        "type": "uuid",
        "idAttribute": true
      },
      {
        "name": "status",
        "type": "string"
      }
    ]
  },
  "pending-shipments": {
    "name": "Pending Shipments",
    "description": "Orders waiting to be shipped.",
    "question": "Which orders are waiting to be shipped?",
    "builtFromEventIds": [
      "order-placed"
    ],
    "fields": [
      {
        "name": "orderId",
        "type": "uuid",
        "idAttribute": true
      },
      {
        "name": "customerId",
        "type": "uuid"
      },
      {
        "name": "customerEmail",
        "type": "string",
        "pii": true,
        "piiSubject": "customerId"
      }
    ],
    "filters": [
      {
        "param": "email",
        "field": "customerEmail",
        "kind": "match",
        "mode": "exact",
        "normalize": "email"
      }
    ]
  }
}
