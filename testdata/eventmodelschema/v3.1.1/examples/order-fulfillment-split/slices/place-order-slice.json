      "given": [],
      "when": {
        "commandId": "place-order",
        "data": {
          "customerId": "cust-1",
          "items": [
            {
              "sku": "WIDGET-1",
              "qty": 2
            }
          ]
        }
      },
      "then": {
        "events": [
          {
            "eventId": "order-placed",
            "data": {
              "orderId": "order-1",
              "customerId": "cust-1"
            }
          }
        ]
      }
    }
  ]
}
