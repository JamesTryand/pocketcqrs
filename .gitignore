# Local dev data
pb_data/
pb_hooks/

# Event store
events.db
events.db-*

# Binaries
*.exe
pocketcqrs

# Editor
.vscode/
.idea/

# Browser-probe dependencies (see pocketcqrs-dashboard/probe/README.md).
# The probes are checked in; the browser driver they need is not.
node_modules/
package-lock.json

# pb_functions/ is YOURS. The shipped examples live in examples/pb_functions/
# (copy what you want into here); nothing in this directory is tracked. Both
# the functions editor and the browser probes write here at runtime, and a PUT
# keeps a .prev copy as its undo -- none of that belongs in the repo.
pb_functions/*
!pb_functions/.gitkeep
*.js.prev
